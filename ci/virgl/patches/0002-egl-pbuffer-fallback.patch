+      virgl_error("Missing EGL_KHR_create_context\n");
+      return false;
+   }
+   if (surfaceless && !has_bit(egl->extension_bits, EGL_KHR_SURFACELESS_CONTEXT)) {
+      virgl_warn("EGL_KHR_surfaceless_context missing - using a 1x1 pbuffer surface instead\n");
+      egl->use_pbuffer = true;
+   }
+   if (!surfaceless && !has_bit(egl->extension_bits, EGL_KHR_SURFACELESS_CONTEXT)) {
+      virgl_error("Missing EGL_KHR_surfaceless_context\n");
       return false;
    }
 
@@ -403,7 +413,7 @@ struct virgl_egl *virgl_egl_init(EGLNativeDisplayType display_id, bool surfacele
    if (!virgl_egl_add_extensions(egl, extensions))
       goto fail;
 
