+/* Monitor resize origin correction: one owned target, one move, finite expiry.
+ * Icon working_area layout is unchanged; this is full monitor geometry. */
+typedef struct { OriginPolicy policy; guint timeout; } FmOrigin;
+static FmOrigin* origin_state(FmDesktop *desktop)
+{
+    FmOrigin *s = g_object_get_data(G_OBJECT(desktop), "fm-origin-target");
+    if (!s) {
+        s = g_new0(FmOrigin, 1);
+        g_object_set_data_full(G_OBJECT(desktop), "fm-origin-target", s, g_free);
+    }
+    return s;
+}
+static gboolean origin_expire(gpointer data)
+{
+    FmDesktop *desktop = FM_DESKTOP(data);
+    FmOrigin *s = origin_state(desktop);
+    s->timeout = 0;
+    if (s->policy.phase) {
+        g_debug("origin generation=%lu result=%d", s->policy.generation, ORIGIN_GIVEUP);
+        s->policy.phase = 0;
+    }
+    return FALSE;
+}
+static void origin_cancel(FmDesktop *desktop)
+{
+    FmOrigin *s = origin_state(desktop);
+    if (s->timeout) { g_source_remove(s->timeout); s->timeout = 0; }
+    s->policy.phase = 0;
+}
+static void origin_target(FmDesktop *desktop, const GdkRectangle *geom)
+{
+    FmOrigin *s = origin_state(desktop);
+    origin_cancel(desktop);
+    origin_begin(&s->policy, geom->x, geom->y, geom->width, geom->height, g_get_monotonic_time());
+    s->timeout = g_timeout_add_full(G_PRIORITY_DEFAULT, ORIGIN_DEADLINE_US / 1000, origin_expire,
+                                   g_object_ref(desktop), g_object_unref);
+}
+static void origin_arm_initial(FmDesktop *desktop)
+{
+    GtkWidget *widget = GTK_WIDGET(desktop);
+    GdkScreen *screen = gtk_widget_get_screen(widget);
+    GdkWindow *window = gtk_widget_get_window(widget);
+    GdkRectangle geom;
+    if (gtk_widget_in_destruction(widget) || !gtk_widget_get_realized(widget) ||
+        !window || gdk_window_is_destroyed(window) || desktop->monitor < 0 ||
+        desktop->monitor >= gdk_screen_get_n_monitors(screen)) return;
+    gdk_screen_get_monitor_geometry(screen, desktop->monitor, &geom);
+    if (geom.width <= 0 || geom.height <= 0) return;
+    origin_target(desktop, &geom);
+}
+static gboolean origin_configure(GtkWidget *widget, GdkEventConfigure *event, gpointer data)
+{
+    FmDesktop *desktop = FM_DESKTOP(widget);
+    FmOrigin *s = origin_state(desktop);
+    GdkScreen *screen;
+    GdkRectangle geom = {0};
+    GdkWindow *window;
+    gint x = 0, y = 0, w = 0, h = 0, decision;
+    gboolean valid;
+    unsigned long generation = s->policy.generation;
+    (void)event; (void)data;
+    if (!s->policy.phase) return FALSE;
+    screen = gtk_widget_get_screen(widget);
+    window = gtk_widget_get_window(widget);
+    valid = !gtk_widget_in_destruction(widget) && gtk_widget_get_realized(widget) &&
+            window && !gdk_window_is_destroyed(window) && desktop->monitor >= 0 &&
+            desktop->monitor < gdk_screen_get_n_monitors(screen);
+    if (valid) {
+        gdk_screen_get_monitor_geometry(screen, desktop->monitor, &geom);
+        valid = gdk_window_get_origin(window, &x, &y);
+        gdk_window_get_geometry(window, NULL, NULL, &w, &h);
+    }
+    decision = origin_event(&s->policy, generation, valid,
+                           geom.x, geom.y, geom.width, geom.height, x, y, w, h,
+                           g_get_monotonic_time());
+    g_debug("origin generation=%lu result=%d x=%d y=%d w=%d h=%d",
+            generation, decision, x, y, w, h);
+    if (decision == ORIGIN_MOVE)
+        gtk_window_move(GTK_WINDOW(desktop), geom.x, geom.y);
+    else if (!s->policy.phase)
+        origin_cancel(desktop);
+    return FALSE;
+}
