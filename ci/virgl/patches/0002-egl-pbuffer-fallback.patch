+      static const EGLint surf_att[] = { EGL_WIDTH, 1, EGL_HEIGHT, 1, EGL_NONE };
+      egl->egl_surf = eglCreatePbufferSurface(egl->egl_display, egl->egl_conf, surf_att);
+      if (!egl->egl_surf) {
+         virgl_error("Failed to create the 1x1 pbuffer fallback surface\n");
+         goto fail;
+      }
+      init_surf = egl->egl_surf;
+   }
+   eglMakeCurrent(egl->egl_display, init_surf, init_surf,
                   egl->egl_ctx);
 
    if (virgl_egl_supports_fences(egl)) {
@@ -453,6 +473,8 @@ void virgl_egl_destroy(struct virgl_egl *egl)
    }
    eglMakeCurrent(egl->egl_display, EGL_NO_SURFACE, EGL_NO_SURFACE,
