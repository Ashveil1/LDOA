--- a/src/vrend/vrend_winsys_egl.c
+++ b/src/vrend/vrend_winsys_egl.c
@@ -103,6 +103,8 @@ struct virgl_egl {
    EGLDisplay egl_display;
    EGLConfig egl_conf;
    EGLContext egl_ctx;
+   EGLSurface egl_surf;   /* 1x1 pbuffer when the display lacks surfaceless */
+   bool use_pbuffer;
    uint32_t extension_bits;
    EGLSyncKHR signaled_fence;
    bool different_gpu;
@@ -186,10 +188,18 @@ static bool virgl_egl_add_extensions(struct virgl_egl *egl, const char *extensio
    return virgl_egl_get_funcs(egl);
 }
 
