+#ifndef LDOA_ORIGIN_POLICY_H
+#define LDOA_ORIGIN_POLICY_H
+/* Pure, finite monitor-generation policy. No timers, GTK or WM mutation here. */
+typedef struct { unsigned long generation; int x,y,w,h,phase,events; long long deadline; } OriginPolicy;
+enum { ORIGIN_DEADLINE_US=2000000, ORIGIN_EVENT_CAP=32 };
+enum { ORIGIN_WAIT=0, ORIGIN_MOVE=1, ORIGIN_NOOP=2, ORIGIN_DONE=3, ORIGIN_GIVEUP=4, ORIGIN_STALE=5 };
+static void origin_begin(OriginPolicy *p,int x,int y,int w,int h,long long now) {
+ ++p->generation;p->x=x;p->y=y;p->w=w;p->h=h;p->phase=1;p->events=0;p->deadline=now+ORIGIN_DEADLINE_US;
+}
+static int origin_event(OriginPolicy *p,unsigned long generation,int valid,int x,int y,int w,int h,int actual_x,int actual_y,int actual_w,int actual_h,long long now) {
+ (void)generation; /* same-thread adapter uses current state; replacement+fresh geometry protect it */
+ if(!p->phase)return ORIGIN_DONE;
+ if(!valid||x!=p->x||y!=p->y||w!=p->w||h!=p->h||now>=p->deadline||++p->events>ORIGIN_EVENT_CAP){p->phase=0;return ORIGIN_GIVEUP;}
+ if(actual_w!=w||actual_h!=h)return ORIGIN_WAIT;
+ if(actual_x==x&&actual_y==y){p->phase=0;return ORIGIN_NOOP;}
+ if(p->phase==2){p->phase=0;return ORIGIN_GIVEUP;}
+ p->phase=2;return ORIGIN_MOVE; /* armed BEFORE caller moves; never twice */
+}
+#endif
